{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/api/tiktok-dm/callback",
      "destination": "/api/tiktok-dm/callback/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/meta-ads",
      "destination": "/api/proxolink?service=advertising"
    },
    {
      "source": "/api/tiktok-dm/callback/",
      "destination": "/api/proxolink?service=advertising&platform=tiktok&op=oauth-callback"
    },
    {
      "source": "/api/tiktok-dm",
      "destination": "/api/proxolink?service=advertising&platform=tiktok"
    },
    {
      "source": "/api/v1/wallet/refund",
      "destination": "/api/proxolink?service=advertising&op=refund"
    },
    {
      "source": "/exchange-admin",
      "destination": "/exchange-admin.html"
    },
    {
      "source": "/exchange-admin1",
      "destination": "/exchange-admin1.html"
    },
    {
      "source": "/api/page-providers",
      "destination": "/api/proxolink?op=providers"
    },
    {
      "source": "/api/page-preview-token",
      "destination": "/api/proxolink?op=form-preview-token"
    },
    {
      "source": "/page-preview",
      "destination": "/api/proxolink?op=form-preview"
    },
    {
      "source": "/page-preview-avatar",
      "destination": "/api/proxolink?op=form-preview-avatar"
    },
    {
      "source": "/contact-preview",
      "destination": "/api/proxolink?op=template-preview"
    },
    {
      "source": "/api/contact-templates",
      "destination": "/api/proxolink?op=templates"
    },
    {
      "source": "/api/contact-ad-links",
      "destination": "/api/proxolink?op=ad-links"
    },
    {
      "source": "/api/contact-preview-token",
      "destination": "/api/proxolink?op=preview-token"
    },
    {
      "source": "/api/contact-card-action",
      "destination": "/api/proxolink?op=card-action"
    },
    {
      "source": "/api/contact-cards",
      "destination": "/api/proxolink?op=cards"
    },
    {
      "source": "/order/:id/avatar",
      "destination": "/api/proxolink?op=order-avatar&id=:id"
    },
    {
      "source": "/download/:id/avatar",
      "destination": "/api/proxolink?op=download-avatar&id=:id"
    },
    {
      "source": "/order/:id",
      "destination": "/api/proxolink?op=order&id=:id"
    },
    {
      "source": "/download/:id",
      "destination": "/api/proxolink?op=download&id=:id"
    },
    {
      "source": "/contact/:id/avatar",
      "destination": "/api/proxolink?op=avatar&id=:id"
    },
    {
      "source": "/contact/:id",
      "destination": "/api/proxolink?op=contact&id=:id"
    },
    {
      "source": "/a/:token/avatar",
      "destination": "/api/proxolink?op=ad-avatar&token=:token"
    },
    {
      "source": "/a/:token/action/:action",
      "destination": "/api/proxolink?op=ad&token=:token&action=:action"
    },
    {
      "source": "/a/:token",
      "destination": "/api/proxolink?op=ad&token=:token"
    },
    {
      "source": "/form-demo",
      "destination": "/form.html"
    },
    {
      "source": "/form/:id",
      "destination": "/form.html"
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/proxolink.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://raw.githubusercontent.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.proxobalance.app"
        }
      ]
    }
  ]
}
