{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/admin",
      "destination": "/api/dispatch?__pb_api_route=admin"
    },
    {
      "source": "/api/balance",
      "destination": "/api/dispatch?__pb_api_route=balance"
    },
    {
      "source": "/api/error-log",
      "destination": "/api/dispatch?__pb_api_route=error-log"
    },
    {
      "source": "/api/forms",
      "destination": "/api/dispatch?__pb_api_route=forms"
    },
    {
      "source": "/api/notify-order",
      "destination": "/api/dispatch?__pb_api_route=notify-order"
    },
    {
      "source": "/api/orders",
      "destination": "/api/dispatch?__pb_api_route=orders"
    },
    {
      "source": "/api/proxolink",
      "destination": "/api/dispatch?__pb_api_route=proxolink"
    },
    {
      "source": "/api/public",
      "destination": "/api/dispatch?__pb_api_route=public"
    },
    {
      "source": "/api/security-admin",
      "destination": "/api/dispatch?__pb_api_route=security-admin"
    },
    {
      "source": "/api/support-cases",
      "destination": "/api/dispatch?__pb_api_route=support-cases"
    },
    {
      "source": "/api/track",
      "destination": "/api/dispatch?__pb_api_route=track"
    },
    {
      "source": "/api/transaction-summary",
      "destination": "/api/dispatch?__pb_api_route=transaction-summary"
    },
    {
      "source": "/exchange-admin",
      "destination": "/exchange-admin.html"
    },
    {
      "source": "/exchange-admin1",
      "destination": "/exchange-admin1.html"
    },
    {
      "source": "/contact-preview",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=template-preview"
    },
    {
      "source": "/api/contact-templates",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=templates"
    },
    {
      "source": "/api/contact-ad-links",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=ad-links"
    },
    {
      "source": "/api/contact-preview-token",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=preview-token"
    },
    {
      "source": "/api/contact-card-action",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=card-action"
    },
    {
      "source": "/api/contact-cards",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=cards"
    },
    {
      "source": "/contact/:id/avatar",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=avatar&id=:id"
    },
    {
      "source": "/contact/:id",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=contact&id=:id"
    },
    {
      "source": "/a/:token/avatar",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=avatar&token=:token"
    },
    {
      "source": "/a/:token/action/:action",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=ad&token=:token&action=:action"
    },
    {
      "source": "/a/:token",
      "destination": "/api/dispatch?__pb_api_route=proxolink&op=ad&token=:token"
    },
    {
      "source": "/form-demo",
      "destination": "/form.html"
    },
    {
      "source": "/form/:id",
      "destination": "/form.html"
    },
    {
      "source": "/summarytransaction/:token",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/dispatch.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/summarytransaction/:token",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'sha256-g+MlOrh19bbJz5W9Rsaz8VLRWx1Fc/cy3aXkvt31qcs='; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://raw.githubusercontent.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.proxobalance.app"
        }
      ]
    }
  ]
}
