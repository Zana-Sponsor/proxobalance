    "constraints": [
      {
        "name": "proxolink_cards_pkey",
        "definition": "PRIMARY KEY (id)"
      },
      {
        "name": "proxolink_cards_user_id_fkey",
        "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
      },
      {
        "name": "proxolink_publish_status_check",
        "definition": "CHECK ((publish_status = ANY (ARRAY['creating'::text, 'ready'::text, 'failed'::text])))"
      },
      {
        "name": "proxolink_publish_attempts_card_id_fkey",
        "definition": "FOREIGN KEY (card_id) REFERENCES proxolink_cards(id) ON DELETE CASCADE"
      },
      {
        "name": "pa_ad_contact_links_card_id_fkey",
        "definition": "FOREIGN KEY (card_id) REFERENCES proxolink_cards(id) ON DELETE RESTRICT"
      },
      {
        "name": "proxolink_card_language_check",
        "definition": "CHECK ((card_language = ANY (ARRAY['ku'::text, 'ar'::text, 'en'::text])))"
      },
      {
        "name": "proxolink_template_version_check",
        "definition": "CHECK ((template_version > 0))"
      },
      {
        "name": "proxolink_platforms_object_check",
        "definition": "CHECK ((jsonb_typeof(platforms) = 'object'::text))"
      },
      {
        "name": "pa_ads_proxolink_asset_fk",
        "definition": "FOREIGN KEY (asset_id) REFERENCES proxolink_cards(id) ON DELETE RESTRICT"
      },
      {
        "name": "pa_ads_proxolink_card_fk",
        "definition": "FOREIGN KEY (card_id) REFERENCES proxolink_cards(id) ON DELETE RESTRICT"
      },
      {
        "name": "proxolink_page_type_check",
        "definition": "CHECK ((page_type = ANY (ARRAY['contact'::text, 'food'::text, 'download'::text])))"
      }
    ]
