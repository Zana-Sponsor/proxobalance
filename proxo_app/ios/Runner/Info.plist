<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Proxo Ads</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.proxo.ads</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>proxo_ads</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- FastPay sends the customer back to this application callback. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.proxo.ads.fastpay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>appfpclientProxo</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>1.0.8</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>8</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>بۆ بارکردنی وێنەی پرۆفایل</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>بۆ هەڵبژاردنی وێنەی پرۆفایل</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>بۆ تۆمارکردنی ڤیدیۆ</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>بۆ ناساندنی شوێن</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- PERF: Impeller چالاک بکە بۆ iOS -->
	<key>FLTEnableImpeller</key>
	<true/>
	<!-- ProxoLink card contact buttons (whatsapp/viber/tel/sms) — iOS only
	     lets url_launcher open these apps if their schemes are declared
	     here; otherwise the buttons silently do nothing. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>viber</string>
		<string>tel</string>
		<string>sms</string>
		<string>fastpay</string>
		<string>appFpp</string>
	</array>
</dict>
</plist>
