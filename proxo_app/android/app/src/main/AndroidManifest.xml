<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ─────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required on Android 13+ to post/show notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps the CPU awake briefly while FCM processes a background message -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Lets FCM re-register the device token after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 11+: پێویستە بڵێین کام URLs دەکرێینەوە (url_launcher) -->
    <queries>
        <!-- https/http بروزەر و TikTok -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- TikTok deep link scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="snssdk1233"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="snssdk1180"/>
        </intent>
        <!-- ProxoLink card contact buttons (whatsapp/viber/tel) — without
             these, url_launcher silently fails to open the real app on
             Android 11+ even when it's installed. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="viber"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <!-- پێشبینینی ناوخۆیی: کردنەوەی فایلێکی HTMLـی خۆماڵی لە وێبگەڕدا.
             بەبێ ئەمە، لەسەر Android 11+ ناتوانرێت ئەو ئەپانە بدۆزرێنەوە
             کە `content://` + text/html دەکەنەوە. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="text/html"/>
        </intent>
        <!-- FastPay app launch scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="fastpay"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="appFpp"/>
        </intent>
    </queries>

    <application
        android:label="Proxo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <!-- PERF: Impeller -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <!-- Launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Lets a tapped FCM notification reopen a TERMINATED app
                 and deliver its data payload to onMessageOpenedApp / getInitialMessage -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

            <!-- FastPay Callback Deep Link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="appfpclientProxo"
                    android:host="fast-pay.cash" />
            </intent-filter>
        </activity>

        <!-- ── FCM background/terminated message handler service ───────── -->
        <!-- Without this the OS cannot wake the app when it is terminated -->
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!-- ── Default notification channel (Android 8+) ──────────────── -->
        <!-- Must match the channel id used in NotificationService._channel -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="proxo_high_importance"/>

        <!-- ── Default notification icon & colour ─────────────────────── -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
