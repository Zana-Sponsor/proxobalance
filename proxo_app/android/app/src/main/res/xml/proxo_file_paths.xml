<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for the local landing-page preview.

  `getTemporaryDirectory()` in Flutter maps to Context.getCacheDir() on
  Android, and LocalHtmlPreview writes into the `proxo_preview/`
  sub-folder of it — so <cache-path path="proxo_preview/"> is exactly the
  narrowest grant that works. Nothing else in the app is exposed.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="proxo_preview"
        path="proxo_preview/" />
</paths>
