<?xml version="1.0" encoding="utf-8"?>
<!--
  Place this file at:
      android/app/src/main/res/values-v31/styles.xml

  Android 12+ ignores the LaunchTheme windowBackground drawable and uses the
  system splash screen API instead. Without these attributes the OS falls back
  to the app theme's default (white / black), which is the flash you are seeing.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- Optional: a 288x288 adaptive icon drawable shown by the OS.
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        -->
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
